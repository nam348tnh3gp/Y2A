# Dockerfile.wheels — Cross-compile Android wheels cho Python 3.13
# Cache bust: 2026-10-09-v3 - lld + cffi + chown
FROM ubuntu:22.04

# ---- Locale ----
RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -qq --yes --no-install-recommends \
        locales ca-certificates && \
    locale-gen en_US.UTF-8 && \
    rm -rf /var/lib/apt/lists/*
ENV LANG="en_US.UTF-8" \
    LANGUAGE="en_US.UTF-8" \
    LC_ALL="en_US.UTF-8" \
    DEBIAN_FRONTEND=noninteractive

# ---- Version pins ----
ENV PYTHON_VERSION=3.13.1 \
    PYTHON_MINOR=3.13 \
    OPENSSL_VERSION=3.3.2 \
    LIBFFI_VERSION=3.4.6 \
    SQLITE_VERSION=3460100 \
    SQLITE_YEAR=2024 \
    XZ_VERSION=5.4.6 \
    ZLIB_VERSION=1.3.1 \
    LIBXML2_VERSION=2.12.6 \
    LIBXSLT_VERSION=1.1.39 \
    LIBJPEGTURBO_VERSION=3.0.3 \
    LIBPNG_VERSION=1.6.43 \
    OPENBLAS_VERSION=0.3.28 \
    ANDROID_API=24 \
    TARGET_HOST=aarch64-linux-android \
    ANDROID_TAG=android_24_arm64_v8a \
    NDK_VERSION=r25c

# ---- Build tools + lld + dev headers ----
RUN apt-get update -qq && \
    apt-get install -y --no-install-recommends \
        build-essential autoconf automake libtool \
        pkg-config wget curl unzip git xz-utils \
        python3 python3-pip patchelf cmake ninja-build nasm \
        binutils file sudo jq \
        lld \
        zlib1g-dev libssl-dev libffi-dev libbz2-dev libreadline-dev \
        libsqlite3-dev liblzma-dev libncurses5-dev libgdbm-dev \
        libnss3-dev uuid-dev tk-dev && \
    rm -rf /var/lib/apt/lists/*

# ============================================================
# Tải Python source tarball — giữ lại cho cross-compile
# ============================================================
ENV PYTHON_SRC=/opt/python-src
RUN mkdir -p ${PYTHON_SRC} && cd ${PYTHON_SRC} && \
    wget -q "https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tar.xz" && \
    ls -lh ${PYTHON_SRC}/

# ============================================================
# Build HOST Python
# ============================================================
ENV HOST_PYTHON=/opt/host-python/bin/python${PYTHON_MINOR}
ENV HOST_PY_PREFIX=/opt/host-python

RUN cd ${PYTHON_SRC} && \
    tar -xf "Python-${PYTHON_VERSION}.tar.xz" && \
    cd "Python-${PYTHON_VERSION}" && \
    env -u CC -u CXX -u AR -u RANLIB -u STRIP -u READELF -u LDSHARED -u CFLAGS -u LDFLAGS -u CPPFLAGS \
        ./configure \
            --prefix=/opt/host-python \
            --disable-optimizations \
            --enable-shared \
            --with-ensurepip=install && \
    env -u CC -u CXX make -j$(nproc) && \
    make install && \
    ldconfig && \
    echo "/opt/host-python/lib" > /etc/ld.so.conf.d/host-python.conf && \
    ldconfig && \
    ${HOST_PYTHON} --version && \
    ${HOST_PYTHON} -c "import zlib, ssl, sqlite3, ctypes; print('OK')" && \
    rm -rf "${PYTHON_SRC}/Python-${PYTHON_VERSION}"

# Host Python build deps — [FIX] thêm cffi cho zstandard
RUN ${HOST_PYTHON} -m pip install --no-cache-dir --upgrade pip setuptools wheel && \
    ${HOST_PYTHON} -m pip install --no-cache-dir \
        "setuptools_scm<8.2" pybind11 maturin meson-python meson ninja \
        pkgconfig Cython expandvars packaging tomli \
        poetry-core flit-core hatchling wheel setuptools-rust \
        scikit-build-core cffi && \
    rm -rf ~/.cache/pip

# ============================================================
# NDK r25c
# ============================================================
ENV NDK=/opt/ndk/android-ndk-${NDK_VERSION}
RUN mkdir -p /opt/ndk && cd /opt/ndk && \
    wget -q https://dl.google.com/android/repository/android-ndk-${NDK_VERSION}-linux.zip && \
    unzip -q android-ndk-${NDK_VERSION}-linux.zip && \
    rm -f android-ndk-${NDK_VERSION}-linux.zip

ENV NDK_TOOLCHAIN=${NDK}/toolchains/llvm/prebuilt/linux-x86_64
ENV CC=${NDK_TOOLCHAIN}/bin/${TARGET_HOST}${ANDROID_API}-clang
ENV CXX=${NDK_TOOLCHAIN}/bin/${TARGET_HOST}${ANDROID_API}-clang++
ENV AR=${NDK_TOOLCHAIN}/bin/llvm-ar
ENV RANLIB=${NDK_TOOLCHAIN}/bin/llvm-ranlib
ENV STRIP=${NDK_TOOLCHAIN}/bin/llvm-strip
ENV READELF=${NDK_TOOLCHAIN}/bin/llvm-readelf
ENV PATH="${NDK_TOOLCHAIN}/bin:${PATH}"

# ============================================================
# Rust
# ============================================================
ENV CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup \
    PATH="/opt/cargo/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain stable --profile minimal && \
    rustup target add aarch64-linux-android && \
    mkdir -p ${CARGO_HOME} && \
    printf '[target.aarch64-linux-android]\nlinker = "%s"\nar = "%s"\n' \
        "${CC}" "${AR}" > ${CARGO_HOME}/config.toml && \
    rustc --version && cargo --version

# ============================================================
# User + chown build dirs
# ============================================================
RUN useradd -m -s /bin/bash builder && \
    mkdir -p /work && \
    echo "builder ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers

RUN chown -R builder:builder \
        /opt/host-python \
        /opt/python-src \
        /opt/cargo \
        /opt/rustup \
        /opt/ndk \
        /work

USER builder
WORKDIR /work