<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.nam2006.y2mate" />
    </queries>

    <application
        android:label="Mini-Y2mate Repository"
        android:icon="@drawable/ic_plugin"
        android:theme="@style/Theme.Material3.DayNight"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- Index chính: wheel tự build -->
        <meta-data
            android:name="pip.index_url"
            android:value="https://nam348tnh3gp.github.io/Y2A/simple/" />

        <!-- Extra index 1: Flet (numpy, pandas, scipy...) -->
        <meta-data
            android:name="pip.extra_index_url"
            android:value="https://pypi.flet.dev/simple/" />

        <!-- Extra index 2: PyPI cho pure Python -->
        <meta-data
            android:name="pip.extra_index_url_2"
            android:value="https://pypi.org/simple/" />

        <meta-data
            android:name="pip.trusted_host"
            android:value="nam348tnh3gp.github.io" />

        <meta-data
            android:name="pip.plugin_version"
            android:value="2" />

        <meta-data
            android:name="pip.companion"
            android:value="Mini-Y2mate Repository" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>